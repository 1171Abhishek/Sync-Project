# Maintainer: Abhishek Kumar <abhishek@example.com>
pkgname=clip-sync
pkgver=0.0.10
pkgrel=1
pkgdesc="Seamless Linux and Android continuity daemon"
arch=('x86_64')
url="https://github.com/1171Abhishek/Sync-Project"
license=('GPL-3.0-only')
depends=('wl-clipboard' 'libnotify' 'xdg-utils')
optdepends=('xclip: for X11 clipboard fallback')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "Sync-Project-$pkgver/clip-sync-rust"
  cargo build --release --locked
}

package() {
  cd "Sync-Project-$pkgver"
  install -Dm755 clip-sync-rust/target/release/clip-sync "${pkgdir}/usr/bin/clip-sync"
  install -Dm644 clip-sync.service "${pkgdir}/usr/lib/systemd/user/clip-sync.service"
}
